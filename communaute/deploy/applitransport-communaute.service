# Serveur communautaire d'AppliTransport : écoute en local, derrière un relais HTTPS (Caddy) sur la même machine.
# Installé par installer.sh.
[Unit]
Description=AppliTransport : serveur communautaire (positions et signalements)
After=network-online.target
Wants=network-online.target

[Service]
User=applitransport-communaute
Group=applitransport-communaute
WorkingDirectory=/opt/applitransport-communaute
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=COMMUNAUTE_RELAIS=1
Environment=COMMUNAUTE_IP_PAR_MINUTE=300
# --no-access-log : aucune adresse IP dans le journal
ExecStart=/opt/applitransport-communaute/venv/bin/uvicorn communaute.serveur:app --host 127.0.0.1 --port 8765 --no-access-log
Restart=on-failure
RestartSec=5

# Ressources bornées : une saturation reste dans ce service
MemoryMax=256M
CPUQuota=100%
TasksMax=64

# Cloisonnement
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
# Joignable seulement par Caddy, sur la même machine
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
